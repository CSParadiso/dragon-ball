<header>
  <div>
    <div>
      <button onclick="
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = '/';
        }
      ">
        ← Volver
      </button>
    </div>
    <div>
      @link({ route: 'home', text: 'Home' })
            <h2>Dragon Ball</h2>
      @end
    </div>
  </div>
</header>
