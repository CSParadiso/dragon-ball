@layout('components/layout')

@slot('main')
<div class="planet-detail">

  <div class="planet-banner">
    <img
      src="{{ planeta.image }}"
      alt="{{ planeta.name }}"
      class="planet-banner-img {{ planeta.isDestroyed ? 'planet-banner-img--destroyed' : '' }}"
    />
    <div class="planet-banner-content">
      <h1>{{ planeta.name }}</h1>
      <div class="planet-banner-badges">
        @if(planeta.isDestroyed)
          <span class="pill-dark pill-destroyed">💥 Destruido</span>
        @else
          <span class="pill-dark">Existente</span>
        @end
      </div>
    </div>
  </div>

  <div class="planet-body">
    <section class="description">
      <h2>Descripción</h2>
      <p>{{ planeta.description }}</p>
    </section>

    <div class="actions">
      <a href="/planetas/{{ planeta.id }}/personajes" class="btn btn-primary">
        Personajes
      </a>
    </div>
  </div>

</div>
@end
@end