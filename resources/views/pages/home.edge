@layout()
  <div class="hero">
    <h1>Universo Dragon Ball</h1>
    <p>Guerreros, dioses, planetas y leyendas de toda la saga.</p>
  </div>
  <div class="cards cards--nav">
    <a href="/personajes" class="card-link cards__nav-link">
      <div class="card">
        <div class="card-image-wrapper">
          <img src="/images/Kaio_del_Norte.webp" alt="Personajes" class="card-image" />
        </div>
        <div class="card-content">
          <h2>Personajes &nbsp;›</h2>
          <p>Guerreros, dioses y leyendas de cada rincón del universo</p>
        </div>
      </div>
    </a>
    <a href="/planetas" class="card-link cards__nav-link">
      <div class="card">
        <div class="card-image-wrapper">
          <img src="/images/Universo_11.webp" alt="Planetas" class="card-image" />
        </div>
        <div class="card-content">
          <h2>Planetas &nbsp;›</h2>
          <p>Descubrí los mundos que dieron forma a la saga Dragon Ball</p>
        </div>
      </div>
    </a>
  </div>
@end